# Copy to .env and fill in your values.
TRACEARR_URL=http://192.168.1.50:3000

# Tracearr > Settings > General > API key (format trr_pub_<token>). Needs Tracearr
# 2.0.0 or later, and the key must belong to an owner account (otherwise 403).
TRACEARR_API_KEY=replace-with-your-tracearr-api-key

# Interface/port the MCP server listens on inside the container.
MCP_HOST=0.0.0.0
MCP_PORT=8942

# Shared secret required as `Authorization: Bearer <token>` on every request.
# Leave unset to run with no auth (anyone who can reach the port can read every
# user's watch history and email address through this server). Strongly
# recommended. Generate one with: openssl rand -hex 32
MCP_AUTH_TOKEN=
